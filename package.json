{
  "name": "prmonitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:web": "vue-tsc --noEmit && vite build --outDir dist-web --base=./",
    "generate:config-types": "cargo test --manifest-path src-tauri/Cargo.toml --locked export_config_types -- --ignored --nocapture",
    "check:config-types": "pnpm run generate:config-types && git diff --exit-code -- src/types.generated.ts src/config/types.generated.ts",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vue/test-utils": "^2.4.11",
    "@vitejs/plugin-vue": "^5.2.1",
    "happy-dom": "^20.10.6",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
