{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/exitplan-self-audit.sh\"",
            "statusMessage": "计划自检…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(bash *fix-self-audit.sh*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/fix-self-audit.sh\"",
            "statusMessage": "fix 决策自检…"
          }
        ]
      }
    ]
  }
}
